# Copy to .env and fill in. Never commit the real .env.

APP_ENV=production
APP_URL=https://your-domain.example
# Set only if the app lives in a sub-folder, e.g. /gradely  (no trailing slash)
APP_BASE_PATH=
APP_TIMEZONE=Africa/Lagos

# Long random string (>= 32 chars). Used to HMAC scratch-card PINs.
# Changing it later invalidates every issued card, so back it up.
APP_SECRET=change-me-to-a-long-random-string

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gradely
DB_USER=gradely_user
DB_PASS=change-me

# One-time token for the /setup page that creates the first Super Admin.
# Remove or blank it after setup.
SETUP_TOKEN=

# Redirect all HTTP traffic to https://<host of APP_URL>. Turn on once your SSL certificate works.
FORCE_HTTPS=0

SESSION_LIFETIME_MIN=120
# Set to 1 only if the host puts the app behind a trusted proxy (Cloudflare etc.)
TRUST_PROXY=0

# Set to 1 for one deployment to run the additive 17 Nov 2026 upgrade, then set back to 0.
AUTO_UPGRADE_2026_11_17=0
